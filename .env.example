# Copie este archivo a .env.development (solo desarrollo) y complete los valores.
# NUNCA ponga estas variables en .env: Vite las incrustaría en el build público.
#
# URL /exec del Apps Script nuevo (servidor del sitio y modo directo).
TABLERO_V2_API_URL=
VITE_TABLERO_V2_API_URL=
# 1 = usar la copia de ejemplo de src/data/tablero.fixture.ts (solo desarrollo).
VITE_TABLERO_FIXTURE=0

# Carga de datos desde /admin. SOLO en el entorno del servidor (Vercel → Environment
# Variables). NUNCA con el prefijo VITE_ ni en .env: terminarían en el build público.
#   ADMIN_CLAVE              la clave que escribe quien carga datos (mínimo 12 caracteres).
#   TABLERO_V2_ADMIN_TOKEN   debe ser IGUAL a la propiedad ADMIN_TOKEN del Apps Script
#                            (mínimo 24 caracteres; sirve: openssl rand -hex 24).
ADMIN_CLAVE=
TABLERO_V2_ADMIN_TOKEN=
